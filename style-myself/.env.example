# Optional — enables the "AI Blend" button, which sends your selfie + a dress
# photo to OpenAI's image model to render a realistic composite.
# Get a key from https://platform.openai.com/api-keys
# Without this set, the app still works fully via Quick Try-On (client-side
# drag-and-fit, no network calls, no API key needed).
OPENAI_API_KEY=

# Optional, defaults to 3000. If you're also running another app in this
# repo (e.g. Tidy Tube) on 3000, set a different port here.
PORT=3000
